{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GPCR Selectivity Atlas public record contract",
  "type": "object",
  "description": "Stable public entities. Null means the metric was not available or was not computed; it never implies a zero value.",
  "$defs": {
    "uniprot": {"type": "string", "pattern": "^[A-Z0-9]+$"},
    "pair_id": {"type": "string", "pattern": "^[A-Z0-9]+__[A-Z0-9]+$"},
    "mmgbsa": {
      "type": "object",
      "description": "Single-minimized-snapshot endpoint rescoring. D = target minus median off-target endpoint; delta = candidate D minus actual-parent D. Computational trends only.",
      "required": ["status", "parent_id", "target_energy_kcal_mol", "offtarget_energy_median_kcal_mol", "differential_kcal_mol", "parent_differential_kcal_mol", "delta_vs_parent_kcal_mol", "improved_vs_parent", "target_pose_count", "offtarget_pose_count", "target_pose_stable", "offtarget_pose_stable", "parent_target_pose_stable", "parent_offtarget_pose_stable"],
      "properties": {
        "status": {"const": "paired_complete"},
        "parent_id": {"type": "string"},
        "target_energy_kcal_mol": {"type": "number"},
        "offtarget_energy_median_kcal_mol": {"type": "number"},
        "differential_kcal_mol": {"type": "number"},
        "parent_differential_kcal_mol": {"type": "number"},
        "delta_vs_parent_kcal_mol": {"type": "number"},
        "improved_vs_parent": {"type": "boolean"},
        "target_pose_count": {"const": 1},
        "offtarget_pose_count": {"type": "integer", "minimum": 1, "maximum": 3},
        "target_pose_stable": {"type": "boolean"},
        "offtarget_pose_stable": {"type": "boolean"},
        "parent_target_pose_stable": {"type": "boolean"},
        "parent_offtarget_pose_stable": {"type": "boolean"}
      }
    },
    "hotspot": {
      "type": "object",
      "required": ["hotspot_id", "rank", "bw", "residues", "fingerprint_difference"],
      "properties": {
        "hotspot_id": {"type": "string"},
        "rank": {"type": "integer", "minimum": 1, "maximum": 3},
        "bw": {"type": "string"},
        "residues": {"type": "string"},
        "fingerprint_difference": {"type": ["number", "null"]}
      }
    },
    "compound": {
      "type": "object",
      "required": ["compound_id", "canonical_smiles", "pair_id", "target_uniprot", "offtarget_uniprot", "seed_record_id", "properties", "docking", "admet", "mmgbsa", "pareto", "evidence", "structure_download"],
      "properties": {
        "compound_id": {"type": "string", "pattern": "^A6PX-"},
        "canonical_smiles": {"type": "string"},
        "pair_id": {"$ref": "#/$defs/pair_id"},
        "target_uniprot": {"$ref": "#/$defs/uniprot"},
        "offtarget_uniprot": {"$ref": "#/$defs/uniprot"},
        "seed_record_id": {"type": "string"},
        "properties": {"type": "object"},
        "docking": {"type": "object"},
        "admet": {"type": "object"},
        "mmgbsa": {"$ref": "#/$defs/mmgbsa"},
        "pareto": {
          "type": "object",
          "required": ["shortlisted", "target_pose_eligible", "seed_relative_eligible", "docking_front", "druglike_front", "admet_front", "domain_front_count"],
          "properties": {
            "shortlisted": {"type": "boolean"},
            "target_pose_eligible": {"type": "boolean"},
            "seed_relative_eligible": {"type": "boolean"},
            "docking_front": {"type": "boolean"},
            "druglike_front": {"type": "boolean"},
            "admet_front": {"type": "boolean"},
            "domain_front_count": {"type": "integer", "minimum": 0, "maximum": 3}
          }
        },
        "structure_download": {
          "type": "object",
          "required": ["availability", "bundle_url", "bundle_size_bytes", "bundle_sha256", "ligand_sdf_count", "complex_pdb_count", "complex_pdbs"],
          "properties": {
            "availability": {"enum": ["ligand_sdf_only", "ligand_sdf_and_complex_pdb"]},
            "bundle_url": {"type": "string", "pattern": "^downloads/structures/A6PX-.+\\.zip$"},
            "bundle_size_bytes": {"type": "integer", "minimum": 1},
            "bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "ligand_sdf_count": {"type": "integer", "const": 1},
            "complex_pdb_count": {"type": "integer", "minimum": 0},
            "complex_pdbs": {"type": "array"}
          }
        },
        "evidence": {
          "type": "object",
          "required": ["final_candidate_904"],
          "properties": {
            "final_candidate_904": {"type": "boolean", "const": true}
          }
        }
      }
    }
  }
}
